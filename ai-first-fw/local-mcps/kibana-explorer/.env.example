# Kibana Logs MCP Server Configuration
# Copy this file to .env and populate with your credentials:
# cp .env.sample .env

# Kibana base URL, including port. No trailing slash.
KIBANA_URL=https://kibana.example.com:5601

# Kibana login (the same username/password you type into the Kibana UI).
KIBANA_USERNAME=your-email@company.com
KIBANA_PASSWORD=your_kibana_password

# Optional: paste a browser session cookie instead of a password.
# Copy the `sid=...` value from DevTools > Application > Cookies on a logged-in
# Kibana tab. Used only if username/password login fails or is left blank.
# KIBANA_COOKIE=sid=Fe26.2**...

# Optional: pinned Kibana version for the kbn-version header.
# Leave unset — the server reads it from /api/status and caches it.
# KIBANA_VERSION=8.19.18

# Optional: default Elasticsearch index pattern for every tool.
KIBANA_INDEX_PATTERN=logs-*-*,logs-*,filebeat-*

# Optional: set to false to accept a self-signed / internal CA certificate.
KIBANA_VERIFY_SSL=true
