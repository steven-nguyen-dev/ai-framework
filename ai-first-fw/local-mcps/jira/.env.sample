# Jira MCP Server Configuration
# Copy this file to .env and populate with your credentials:
# cp .env.sample .env

# Your Jira instance base URL (e.g., https://your-domain.atlassian.net or https://jira.yourcompany.com)
JIRA_HOST=https://your-domain.atlassian.net

# Your Jira login email address
JIRA_EMAIL=your-email@company.com

# Jira API Token (Generate at: https://id.atlassian.com/manage-profile/security/api-tokens)
# If using Jira Server / Data Center with a Personal Access Token (PAT), set JIRA_PAT instead.
JIRA_API_TOKEN=your_jira_api_token_here

# Optional: Personal Access Token (for Jira Server / Data Center)
# JIRA_PAT=your_personal_access_token_here

# Optional: Default directory where downloaded attachments will be saved (default: ./downloads)
JIRA_DOWNLOAD_DIR=./downloads

# Optional: API Version (3 for Jira Cloud default, 2 for Jira Server/Data Center)
JIRA_API_VERSION=3
